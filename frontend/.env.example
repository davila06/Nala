# ──────────────────────────────────────────────────────────────────────────────
# PawTrack CR — Frontend environment variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local or .env.production to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────
# URL base de la API backend (sin trailing slash).
# Dev local: http://localhost:5199
# Staging:   https://api-staging.pawtrack.cr
# Prod:      https://api.pawtrack.cr
VITE_API_URL=http://localhost:5199
VITE_VAPID_PUBLIC_KEY=<tu-vapid-public-key>
# Número E.164 sin + para el botón de pedido de collares físicos (ej: 50612345678). Dejar vacío para ocultar el botón.
VITE_COLLAR_WHATSAPP_NUMBER=

# ── Push Notifications (Web Push / VAPID) ─────────────────────────────────────
# Clave pública VAPID para suscripciones Web Push.
# Generar con: npx web-push generate-vapid-keys
# La clave privada va SOLO en el backend (Key Vault: vapid-private-key).
VITE_VAPID_PUBLIC_KEY=

# ── Application Insights (Frontend telemetría) ────────────────────────────────
# Connection string de Azure Application Insights para el SDK JS.
# Obtener de: Azure Portal → Application Insights → Overview → Connection String
# Dejar vacío en local para deshabilitar telemetría.
VITE_APPINSIGHTS_CONNECTION_STRING=

# ── Feature flags ─────────────────────────────────────────────────────────────
# Habilitar modo debug de desarrollo (logs adicionales en consola).
# Establecer en false en staging/prod.
VITE_DEBUG=false
