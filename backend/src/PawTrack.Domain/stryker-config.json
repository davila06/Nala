{
  "stryker-config": {
    "project": "PawTrack.Domain.csproj",
    "test-projects": ["../../tests/PawTrack.UnitTests/PawTrack.UnitTests.csproj"],
    "mutation-level": "Standard",
    "reporters": ["html", "json", "progress"],
