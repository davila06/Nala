{
  "stryker-config": {
    "project": "PawTrack.Application.csproj",
    "test-projects": [
      "../../tests/PawTrack.UnitTests/PawTrack.UnitTests.csproj"
    ],
    "mutation-level": "Standard",
    "reporters": ["html", "json", "progress"],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "ignore-methods": ["ToString", "GetHashCode", "Equals", "CompareTo"],
    "coverage-analysis": "perTest"
  }
}
