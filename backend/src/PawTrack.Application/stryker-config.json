{
  "stryker-config": {
    "solution": "../../PawTrack.sln",
    "project": "PawTrack.Application.csproj",
    "test-projects": ["../PawTrack.UnitTests/PawTrack.UnitTests.csproj"],
    "mutation-level": "Standard",
    "reporters": ["html", "json", "progress"],
    "output-path": "StrykerOutput",
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 50
    },
    "ignore-methods": ["ToString", "GetHashCode", "Equals", "CompareTo"],
    "excluded-mutations": ["String", "Linq"],
    "coverage-analysis": "perTest",
    "since": {
      "enabled": false,
      "git-diff-target": "main"
    }
  }
}
